# Application
APP_NAME=AI Career Assistant API
APP_ENV=development
DEBUG=true

# CORS — comma-separated list of allowed origins.
# Local dev: keep localhost entries.
# Production (Render): set to your Vercel frontend URL only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_UPLOAD_SIZE_MB=10

# Authentication
# REQUIRED — PostgreSQL connection string (e.g. Neon, Supabase, Render Postgres, or a local
# Postgres instance for dev). There is no default and no SQLite fallback: the app fails fast
# at startup if this isn't set.
DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyzer
# REQUIRED in production — generate a long random value (e.g. `openssl rand -hex 32`) and set it
# in the Render dashboard. The default below is dev-only and NOT secure: anyone who reads this
# file could forge valid login tokens against a deployment still using it.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Password reset emails (sent via Resend — https://resend.com). Get an API key from your Resend
# dashboard. Without RESEND_API_KEY, forgot-password requests still succeed (no user enumeration)
# but the email is just logged, not actually sent — fine for local dev.
RESEND_API_KEY=your-resend-api-key
# Resend's shared onboarding@resend.dev sender works without verifying your own domain (useful
# for dev/testing); switch to an address on a domain you've verified in Resend for production.
EMAIL_FROM=onboarding@resend.dev
# Base URL of the deployed frontend — used to build the link in the reset-password email.
# Local dev: keep as-is. Production (Render): set to your Vercel frontend URL.
FRONTEND_URL=http://localhost:5173

# Azure OpenAI — required for the resume analysis, company recommendation, and interview
# prep agents. All values are available in your Azure portal under the deployment details.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=your-gpt-4-1-deployment-name
# Required for company interview-prep RAG (embeds the company knowledge base into FAISS).
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=your-embeddings-deployment-name
